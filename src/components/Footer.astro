---
const columns = [
	{
		title: 'Tools',
		links: [
			{ href: '/', label: 'Multi-City Meeting Planner' },
			{ href: '/meeting-time-calculator', label: 'Best Time to Call / Two-City Calculator' },
			{ href: '/timezone-converter', label: 'Timezone Converter' },
			{ href: '/world-clock', label: 'World Clock' },
		],
	},
	{
		title: 'Popular pairs',
		links: [
			{ href: '/meeting-time/new-york-to-london', label: 'New York to London' },
			{ href: '/meeting-time/new-york-to-mumbai', label: 'New York to Mumbai' },
			{ href: '/meeting-time/london-to-singapore', label: 'London to Singapore' },
			{ href: '/meeting-time', label: 'Browse all city pairs' },
		],
	},
	{
		title: 'Company',
		links: [
			{ href: '/about', label: 'About us' },
			{ href: '/contact', label: 'Contact us' },
			{ href: '/privacy-policy', label: 'Privacy policy' },
			{ href: '/terms', label: 'Terms & conditions' },
		],
	},
];
---

<footer class="border-t border-hairline bg-canvas">
	<div class="mx-auto max-w-6xl px-6 py-16">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:[grid-template-columns:2fr_1fr_1fr_1fr]">
			<div>
				<p class="text-label-sm font-semibold text-ink">MeetingPlannerTimeZone</p>
				<p class="mt-2 max-w-md text-body-sm text-mute">
					Find the best time to meet or call across time zones — no sign-up, no clutter, just a clear
					answer.
				</p>
			</div>
			{
				columns.map((column) => (
					<div>
						<p class="text-mono-eyebrow uppercase text-mute">{column.title}</p>
						<ul class="mt-3 flex flex-col gap-2">
							{column.links.map((link) => (
								<li>
									<a href={link.href} class="text-body-md text-body hover:text-ink">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="mt-16 text-body-sm text-faint">
			© {new Date().getFullYear()} MeetingPlannerTimeZone.com
		</p>
	</div>
</footer>
