---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const columns = [
	{
		title: t('footer.tools'),
		links: [
			{ href: translatePath('/'), label: t('footer.tools.planner') },
			{ href: translatePath('/meeting-time-calculator'), label: t('footer.tools.calculator') },
			{ href: translatePath('/timezone-converter'), label: t('footer.tools.converter') },
			{ href: translatePath('/world-clock'), label: t('footer.tools.worldclock') },
		],
	},
	{
		// City-pair pages are English-only, so these links are never localized.
		title: t('footer.pairs'),
		links: [
			{ href: '/meeting-time/new-york-to-london', label: t('footer.pairs.nyLondon') },
			{ href: '/meeting-time/new-york-to-mumbai', label: t('footer.pairs.nyMumbai') },
			{ href: '/meeting-time/london-to-singapore', label: t('footer.pairs.londonSingapore') },
			{ href: '/meeting-time', label: t('footer.pairs.browseAll') },
		],
	},
	{
		title: t('footer.company'),
		links: [
			{ href: translatePath('/about'), label: t('footer.company.about') },
			{ href: translatePath('/contact'), label: t('footer.company.contact') },
			{ href: translatePath('/privacy-policy'), label: t('footer.company.privacy') },
			{ href: translatePath('/terms'), label: t('footer.company.terms') },
		],
	},
];

const canonicalPath = (() => {
	const prefixMatch = Astro.url.pathname.match(/^\/([a-z]{2})(\/|$)/);
	if (prefixMatch && prefixMatch[1] in languages && prefixMatch[1] !== 'en') {
		return Astro.url.pathname.slice(prefixMatch[1].length + 1) || '/';
	}
	return Astro.url.pathname;
})();
---

<footer class="border-t border-hairline bg-canvas">
	<div class="mx-auto max-w-6xl px-6 py-16">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:[grid-template-columns:2fr_1fr_1fr_1fr]">
			<div>
				<p class="text-label-sm font-semibold text-ink">MeetingPlannerTimeZone</p>
				<p class="mt-2 max-w-md text-body-sm text-mute">
					{t('footer.tagline')}
				</p>
			</div>
			{
				columns.map((column) => (
					<div>
						<p class="text-mono-eyebrow uppercase text-mute">{column.title}</p>
						<ul class="mt-3 flex flex-col gap-2">
							{column.links.map((link) => (
								<li>
									<a href={link.href} class="text-body-md text-body hover:text-ink">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<div class="mt-16 flex flex-wrap items-center gap-x-4 gap-y-2">
			<span class="text-mono-eyebrow uppercase text-mute">{t('footer.language')}</span>
			<ul class="flex flex-wrap gap-x-3 gap-y-1">
				{
					Object.entries(languages).map(([code, label]) => {
						const altTranslatePath = useTranslatedPath(code as keyof typeof languages);
						const href = altTranslatePath(canonicalPath);
						const isActive = code === lang;
						return (
							<li>
								<a
									href={href}
									aria-current={isActive ? 'true' : undefined}
									class={`text-body-sm ${isActive ? 'font-semibold text-ink' : 'text-mute hover:text-ink'}`}
								>
									{label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>
		<p class="mt-4 text-body-sm text-faint">
			© {new Date().getFullYear()} MeetingPlannerTimeZone.com
		</p>
	</div>
</footer>
