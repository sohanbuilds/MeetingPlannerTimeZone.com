---
import '../styles/global.css';
import { languages, defaultLang, showDefaultLang } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const {
	title = 'Meeting Planner — Find the Best Time to Meet Across Time Zones',
	description = 'A free meeting planner and world clock for time zone scheduling. Compare working hours across cities, get a Comfort Score for every slot, and share the best global meeting time instantly.',
	image = '/og-image.png',
	type = 'website',
	noindex = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);

// Pages that exist in every language — the canonical path with any /<lang>/ prefix stripped.
// Only these get hreflang alternates; English-only pages (e.g. generated city-pair pages)
// have no translated counterpart to point to, so they get none.
const translatedPaths = new Set([
	'/',
	'/about',
	'/contact',
	'/privacy-policy',
	'/terms',
	'/meeting-time-calculator',
	'/timezone-converter',
	'/world-clock',
]);

function pathWithoutLang(pathname: string): string {
	const prefixMatch = pathname.match(/^\/([a-z]{2})(\/|$)/);
	const stripped =
		prefixMatch && prefixMatch[1] in languages && prefixMatch[1] !== defaultLang
			? pathname.slice(prefixMatch[1].length + 1) || '/'
			: pathname;
	// Normalize away the trailing slash Astro's static build adds to directory routes,
	// so it matches the no-trailing-slash entries in translatedPaths (except root "/").
	return stripped !== '/' && stripped.endsWith('/') ? stripped.slice(0, -1) : stripped;
}

const canonicalPath = pathWithoutLang(Astro.url.pathname);
const hasTranslations = translatedPaths.has(canonicalPath);

function localizedHref(targetLang: string): string {
	const path = !showDefaultLang && targetLang === defaultLang ? canonicalPath : `/${targetLang}${canonicalPath}`;
	const withTrailingSlash = path === '/' ? path : `${path}/`;
	return new URL(withTrailingSlash, Astro.site).toString();
}

const ogLocales: Record<string, string> = {
	en: 'en_US',
	es: 'es_ES',
	ja: 'ja_JP',
	fr: 'fr_FR',
	de: 'de_DE',
	pt: 'pt_PT',
	ko: 'ko_KR',
	it: 'it_IT',
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const siteName = 'MeetingPlannerTimeZone';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MeetingPlannerTimeZone" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<title>{title}</title>

		{
			hasTranslations && (
				<>
					{Object.keys(languages).map((altLang) => (
						<link rel="alternate" hreflang={altLang} href={localizedHref(altLang)} />
					))}
					<link rel="alternate" hreflang="x-default" href={localizedHref(defaultLang)} />
				</>
			)
		}

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={ogLocales[lang]} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased">
		<slot />
	</body>
</html>
