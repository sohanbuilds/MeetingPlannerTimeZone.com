---
import ToolLayout from '../layouts/ToolLayout.astro';

const contactEmail = 'hello@meetingplannertimezone.com';
---

<ToolLayout
	title="Contact Us — MeetingPlannerTimeZone"
	description="Get in touch with the MeetingPlannerTimeZone team — report a bug, suggest a feature, or ask a question."
>
	<section class="hero-mesh border-b border-hairline bg-canvas px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<p class="text-mono-eyebrow uppercase text-mute">Contact us</p>
			<h1 class="mt-2 text-display-xl text-ink">Get in touch</h1>
			<p class="mt-4 max-w-2xl text-body-lg text-body">
				Questions, bug reports, and feature requests are all welcome.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-6 pb-24 pt-16">
		<div class="flex flex-col gap-8">
			<div>
				<h2 class="text-heading-md text-ink">Email</h2>
				<p class="mt-3 text-body-lg text-body">
					The best way to reach us is by email at
					<a href={`mailto:${contactEmail}`} class="text-link hover:text-link-deep">{contactEmail}</a>. We
					read every message and try to reply as soon as we can.
				</p>
			</div>

			<div>
				<h2 class="text-heading-md text-ink">Reporting a bug</h2>
				<p class="mt-3 text-body-lg text-body">
					If something looks wrong — a conversion, a city's offset, or a display glitch — let us know which
					cities and dates you were using so we can reproduce it quickly.
				</p>
			</div>

			<div>
				<h2 class="text-heading-md text-ink">Privacy and legal</h2>
				<p class="mt-3 text-body-lg text-body">
					For questions about how the site works, see our <a
						href="/privacy-policy"
						class="text-link hover:text-link-deep">Privacy Policy</a
					> and <a href="/terms" class="text-link hover:text-link-deep">Terms &amp; Conditions</a>.
				</p>
			</div>
		</div>
	</section>
</ToolLayout>
