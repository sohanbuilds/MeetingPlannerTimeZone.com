---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { languages, defaultLang } from '../../i18n/ui';
import { useTranslatedPath } from '../../i18n/utils';
import { aboutContent } from '../../i18n/content/about';

export function getStaticPaths() {
	return Object.keys(languages)
		.filter((l) => l !== defaultLang)
		.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const content = aboutContent[locale!];
const translatePath = useTranslatedPath(locale as keyof typeof languages);
---

<ToolLayout title={content.title} description={content.description}>
	<section class="hero-mesh border-b border-hairline bg-canvas px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<p class="text-mono-eyebrow uppercase text-mute">{content.eyebrow}</p>
			<h1 class="mt-2 text-display-xl text-ink">{content.h1}</h1>
			<p class="mt-4 max-w-2xl text-body-lg text-body">{content.intro}</p>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-6 pb-24 pt-16">
		<div class="flex flex-col gap-8">
			<div>
				<h2 class="text-heading-md text-ink">{content.whyTitle}</h2>
				<p class="mt-3 text-body-lg text-body">{content.whyBody}</p>
			</div>

			<div>
				<h2 class="text-heading-md text-ink">{content.howTitle}</h2>
				<p class="mt-3 text-body-lg text-body">{content.howBody}</p>
			</div>

			<div>
				<h2 class="text-heading-md text-ink">{content.feedbackTitle}</h2>
				<p class="mt-3 text-body-lg text-body">
					{content.feedbackBody} <a href={translatePath('/contact')} class="text-link hover:text-link-deep">{content.feedbackCta}</a>
				</p>
			</div>
		</div>
	</section>
</ToolLayout>
