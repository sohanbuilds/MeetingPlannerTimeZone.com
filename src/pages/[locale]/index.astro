---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { MeetingPlanner } from '../../islands/MeetingPlanner';
import { languages, defaultLang } from '../../i18n/ui';
import { useTranslatedPath } from '../../i18n/utils';
import { homeContent } from '../../i18n/content/home';

export function getStaticPaths() {
	return Object.keys(languages)
		.filter((l) => l !== defaultLang)
		.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const content = homeContent[locale!];
const translatePath = useTranslatedPath(locale as keyof typeof languages);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'MeetingPlannerTimeZone',
	alternateName: 'Meeting Planner',
	url: `https://meetingplannertimezone.com/${locale}/`,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	description: content.description,
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: content.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<ToolLayout title={content.title} description={content.description}>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
	<section class="hero-mesh border-b border-hairline bg-canvas px-6 py-32">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-mono-eyebrow uppercase text-mute">{content.hero.eyebrow}</p>
			<h1 class="mt-2 text-display-xl text-ink">
				{content.hero.titlePrefix}<span class="gradient-text">{content.hero.titleHighlight}</span>{content.hero.titleSuffix}
			</h1>
			<p class="mt-4 text-body-lg text-body">{content.hero.body}</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16">
		<MeetingPlanner client:only="preact" />
	</section>

	<section class="border-t border-hairline bg-canvas px-6 py-24">
		<div class="mx-auto max-w-6xl">
			<p class="text-center text-mono-eyebrow uppercase text-mute">{content.featuresEyebrow}</p>
			<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
				{
					content.features.map((feature) => (
						<div class="card card-interactive">
							<span class="text-heading-lg" aria-hidden="true">
								{feature.icon}
							</span>
							<h2 class="mt-3 text-heading-md text-ink">{feature.title}</h2>
							<p class="mt-2 text-body-md text-body">{feature.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas px-6 py-24">
		<div class="mx-auto max-w-3xl">
			<p class="text-mono-eyebrow uppercase text-mute">{content.about.eyebrow}</p>
			<h2 class="mt-2 text-heading-lg text-ink">{content.about.h2}</h2>
			<p class="mt-4 text-body-md text-body">{content.about.p1}</p>
			<p class="mt-4 text-body-md text-body">{content.about.p2}</p>

			<h3 class="mt-8 text-heading-md text-ink">{content.about.h3Comfort}</h3>
			<p class="mt-3 text-body-md text-body">{content.about.p3}</p>
			<p class="mt-3 text-body-md text-body">{content.about.p4}</p>

			<h3 class="mt-8 text-heading-md text-ink">{content.about.h3International}</h3>
			<p class="mt-3 text-body-md text-body">{content.about.p5}</p>
			<p class="mt-3 text-body-md text-body">{content.about.p6}</p>

			<h3 class="mt-8 text-heading-md text-ink">{content.about.h3Details}</h3>
			<p class="mt-3 text-body-md text-body">{content.about.p7}</p>
			<p class="mt-3 text-body-md text-body">{content.about.p8}</p>

			<h3 class="mt-8 text-heading-md text-ink">{content.about.h3Share}</h3>
			<p class="mt-3 text-body-md text-body">{content.about.p9}</p>

			<h3 class="mt-8 text-heading-md text-ink">{content.about.h3Who}</h3>
			<p class="mt-3 text-body-md text-body">{content.about.p10}</p>
			<p class="mt-3 text-body-md text-body">
				{content.about.p11Before}
				<a href={translatePath('/meeting-time-calculator')} class="text-link hover:text-link-deep">{content.about.linkCalculator}</a
				>{content.about.p11Mid1}
				<a href={translatePath('/timezone-converter')} class="text-link hover:text-link-deep">{content.about.linkConverter}</a>{content.about.p11Mid2}
				<a href={translatePath('/world-clock')} class="text-link hover:text-link-deep">{content.about.linkWorldClock}</a>{content.about.p11After}
			</p>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas px-6 py-24">
		<div class="mx-auto max-w-3xl">
			<p class="text-mono-eyebrow uppercase text-mute">{content.faqEyebrow}</p>
			<h2 class="mt-2 text-heading-lg text-ink">{content.faqH2}</h2>
			<div class="mt-6 flex flex-col gap-4">
				{
					content.faqs.map((faq) => (
						<details class="card group">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-heading-md text-ink [&::-webkit-details-marker]:hidden">
								{faq.q}
								<span class="shrink-0 text-mute transition-transform duration-150 group-open:rotate-180" aria-hidden="true">
									▾
								</span>
							</summary>
							<p class="mt-3 text-body-md text-body">{faq.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>
</ToolLayout>
